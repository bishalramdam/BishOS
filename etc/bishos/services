# BishOS service table.
#
#   <name>  <action>  <command...>
#
#   respawn  start at boot, restart whenever it exits
#   once     run at boot, do not restart
#   console  respawn, and give it the controlling terminal (job control)
#
# The command is split on whitespace only -- there is no quoting, and no
# shell is involved unless you ask for one explicitly.
#
# A service that dies immediately is retried with a growing delay rather
# than in a tight loop, so a broken command cannot peg the CPU.

# The console session. Not a shell directly any more: the script decides
# whether this boot needs first-boot password setup, then hands over to
# login. "console" is what gives it the controlling terminal it needs to
# prompt with echo off.
console   console   /bin/sh /etc/bishos/console

# Logging. dmesg is a ring buffer in RAM: it is overwritten as it fills and is
# gone entirely at reboot, so nothing from a previous boot can be read back.
# syslogd writes to a file on the persistent root instead, and klogd copies
# the kernel's own messages into it, which is the half that outlives a reboot.
#
# -s/-b cap the log at 200KB x 5 rotations, because a root filesystem filled
# by its own log file is a worse failure than a truncated log. syslogd is
# listed first so its socket exists before klogd has anything to say.
syslogd   respawn   /sbin/syslogd -n -O /var/log/messages -s 200 -b 5 -D
klogd     respawn   /sbin/klogd -n

# Keep the clock correct. The kernel sets the time from the hardware clock at
# boot, but nothing corrects the drift after that -- and a wrong clock breaks
# TLS in a way that looks like a certificate problem rather than a time one.
# -n keeps ntpd in the foreground so this supervisor can see it exit, and -S
# runs a script that writes the corrected time back to the hardware clock.
ntpd      respawn   /sbin/ntpd -n -S /etc/bishos/ntp-step -p 0.pool.ntp.org -p 1.pool.ntp.org

# Remote access, off until asked for. The wrapper waits for
# /etc/bishos/ssh.enabled and only then generates host keys and listens, so a
# machine that never wants ssh never opens port 22 and never has a host key
# sitting on it.  Turn it on with:  sudo touch /etc/bishos/ssh.enabled
sshd      respawn   /bin/sh /etc/bishos/sshd

# Device permissions and hardware discovery. BishOS has no udev of its own:
# devtmpfs creates device nodes as root:root 600, so nothing but root can use
# the GPU or the input devices, and libinput asks udev which devices are
# keyboards -- with no udev database it finds nothing whatever the permissions
# say. devperms sets the groups; udev starts eudev and tells it to look at
# hardware that appeared before it did.
devperms  once     /etc/bishos/devperms
udev      once     /etc/bishos/udev

# The browser cache in RAM rather than on the disk: Chromium writes to it
# constantly, and on a USB stick that is slow and wears the stick out. Only
# Chromium -- the rest of ~/.cache is small, rarely written, and some of it
# (the launcher's ranking, compiled shaders, the font index) is worth keeping.
tmpfscache once    /etc/bishos/tmpfs-cache

# A seat manager, so a compositor can use the screen and input devices without
# running as root. -g is not optional: without it the socket is owned by
# root:root and members of the seat group still cannot open it.
#
#   sshd/sway note: install first --  apk add seatd sway foot
# seatd     respawn  /usr/bin/seatd -g seat

# Examples, once the packages are installed:
#
#   ntpd    respawn   /usr/sbin/ntpd -n -d
#   motd    once      /bin/sh /etc/bishos/first-boot.sh
