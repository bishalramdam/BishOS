#!/bin/sh
# Put the browser cache in RAM -- only the browser cache.
#
# Chromium writes to its cache constantly. On USB flash that is slow and wears
# the stick out, and nothing in there is worth keeping across a reboot.
#
# This once covered the whole of ~/.cache, which was too broad. That directory
# is named "cache" but not everything under it is disposable:
#
#   fuzzel             34 bytes ranking the apps you launch most. In RAM, the
#                      launcher forgets your habits at every reboot and the
#                      list is alphabetical again.
#   mesa_shader_cache  compiled GPU shaders. Losing them means recompiling on
#                      first use, so games and the browser stutter once after
#                      each boot for no reason.
#   fontconfig         the font index, rebuilt by scanning every font on the
#                      disk. Small, slow to regenerate.
#
# All three are tiny and rarely written -- the exact opposite of the problem
# this solves. Only Chromium is mounted now, so they stay on disk.
#
# The user is found rather than named: BishOS asks for a username on first
# boot, so there is nothing to hard-code here.
SIZE=512M

awk -F: '$3 >= 1000 && $3 < 65534 { print $1 ":" $3 ":" $4 ":" $6 }' /etc/passwd |
while IFS=: read -r name uid gid home; do
    [ -d "$home" ] || continue

    # The mount point has to exist on disk before anything can be mounted on
    # it, and has to belong to the user or Chromium cannot write there.
    mkdir -p "$home/.cache/chromium"
    chown "$uid:$gid" "$home/.cache" "$home/.cache/chromium"

    mountpoint -q "$home/.cache/chromium" && continue
    mount -t tmpfs -o "size=$SIZE,mode=0700,uid=$uid,gid=$gid" \
        tmpfs "$home/.cache/chromium"
done
exit 0
