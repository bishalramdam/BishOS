#!/bin/sh
# sshd, started from the service table.

# openssh is a package on the persistent root, not part of the base system:
# busybox has no ssh server, and the real one is dynamically linked, so it
# could not live in the static initramfs even if it were wanted there. A
# RAM-only boot therefore has no sshd -- and no accounts to let anyone into
# either, since it deliberately skips login.
if [ ! -x /usr/sbin/sshd ]; then
    echo "[BishOS] sshd: openssh not installed (apk add openssh-server)"
    # Sleep rather than exit. Exiting would have the supervisor restart this
    # every thirty seconds forever, and the message would scroll a live ISO
    # console for as long as it was left running.
    exec sleep 86400
fi

# Host keys are generated here, on the machine, the first time it boots --
# never shipped in the image. A host key baked into an ISO is the same private
# key on every BishOS install in the world, which is precisely the thing host
# keys exist to prevent. -A creates only what is missing, so later boots are
# a no-op.
ssh-keygen -A

# -D keeps sshd in the foreground so the supervisor can see it exit; -e sends
# its log to stderr rather than syslog.
exec /usr/sbin/sshd -D -e
