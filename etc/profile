# /etc/profile: System-wide environment configuration for BishOS

# /usr/local is where locally built software belongs -- anything compiled on
# the machine rather than installed by apk. Without it on PATH, everything you
# build yourself is invisible unless typed as a full path, which is a strange
# way to discover that your own program "does not exist".
export PATH=/usr/local/bin:/usr/local/sbin:/bin:/sbin:/usr/bin:/usr/sbin
export TERM=xterm-256color
export PAGER=less
export EDITOR=vi

# Detect current user
CURRENT_USER=$(id -un 2>/dev/null || echo "root")
export USER=$CURRENT_USER

# Set home directory
if [ "$USER" = "root" ]; then
    export HOME=/root
else
    export HOME="/home/$USER"
fi

# Per-user binaries. Tools installed by curl-pipe-shell installers land in
# ~/.local/bin, which nothing else adds to PATH. The case guard keeps PATH
# from growing on every login, and this comes after HOME is decided above.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Fancy colored shell prompt. \h is the real hostname rather than a literal,
# so a machine renamed on first boot says its own name at every prompt.
# Green for root, cyan for everyone else.
if [ "$(id -u)" = "0" ]; then
    export PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]# '
else
    export PS1='\[\033[01;36m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]$ '
fi

# Useful shell aliases
alias ls='ls --color=auto'
alias ll='ls -la --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias df='df -h'
alias free='free -m'
alias clear='printf "\033c"'
alias cls='printf "\033c"'

# Switch into HOME directory on login
cd "$HOME" 2>/dev/null || cd /

# Drop-ins from packages.
#
# A package that needs something in the environment installs a snippet here
# rather than editing /etc/profile, and every distribution's profile sources
# them. This one did not, so three snippets sat in /etc/profile.d being
# ignored -- including the one flatpak installs to put its exports on
# XDG_DATA_DIRS, without which flatpak applications never appear in any
# launcher. The failure is silent: the file is present, correct, and read by
# nobody.
#
# Sourced first, so anything set below wins over a package's default.
if [ -d /etc/profile.d ]; then
    for _f in /etc/profile.d/*.sh; do
        [ -r "$_f" ] && . "$_f"
    done
    unset _f
fi

# A locale, because a great deal of software assumes LANG exists and crashes
# without checking. nwg-panel-config died on
#
#     os.getenv("LANG").split(".")[0]
#
# which is AttributeError: 'NoneType' has no attribute 'split' -- a stack trace
# about strings, from a variable nobody set.
#
# C.UTF-8 rather than en_US.UTF-8 because musl implements only the C and POSIX
# locales plus UTF-8 character handling; naming a locale it does not have would
# be a fiction that some programs check for and others do not. Software that
# splits LANG on "." gets "C", finds no translation for it, and falls back to
# English, which is the intended result here anyway.
export LANG=C.UTF-8
export LC_COLLATE=C

# Wayland compositors keep their sockets in a private per-user directory and
# refuse to start without one. On a normal system a login manager creates it;
# BishOS has none, so it is made here at login.
export XDG_RUNTIME_DIR=/run/user/$(id -u)
if [ ! -d "$XDG_RUNTIME_DIR" ]; then
    mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
fi
