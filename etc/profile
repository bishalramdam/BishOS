# /etc/profile: System-wide environment configuration for BishOS

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export TERM=xterm-256color
export PAGER=less
export EDITOR=vi

# Detect current user
CURRENT_USER=$(id -un 2>/dev/null || echo "root")
export USER=$CURRENT_USER

# Set home directory
if [ "$USER" = "root" ]; then
    export HOME=/root
else
    export HOME="/home/$USER"
fi

# Fancy colored shell prompt:
# Green for root: [root@BishOS ~]#
# Cyan for normal users: [bishal@BishOS ~]$
if [ "$(id -u)" = "0" ]; then
    export PS1='\[\033[01;32m\]\u@BishOS\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]# '
else
    export PS1='\[\033[01;36m\]\u@BishOS\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]$ '
fi

# Useful shell aliases
alias ls='ls --color=auto'
alias ll='ls -la --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias df='df -h'
alias free='free -m'
alias clear='printf "\033c"'
alias cls='printf "\033c"'

# Switch into HOME directory on login
cd "$HOME" 2>/dev/null || cd /
