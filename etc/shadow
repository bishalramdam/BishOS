# Both accounts ship LOCKED. "!" is not a password hash -- it is the marker
# that means "no password will ever match", so nothing can log in until the
# first boot asks for one. That is deliberate: a default password committed to
# a public repository is a password everybody knows and nobody changes.
#
# init's console service rewrites these two lines the first time BishOS boots
# on a persistent root. Fields are:
#   name:hash:last-change:min-age:max-age:warn:inactive:expire:reserved
root:!:20000:0:99999:7:::
bishal:!:20000:0:99999:7:::
