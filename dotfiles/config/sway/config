# ============================================================
#  READ THE END FIRST
# ============================================================
#
# This machine floats by default, macOS-style: windows overlap, are dragged
# and resized with the mouse, and do not tile.
#
# Most of what follows is sway's stock configuration, and its comments
# describe tiling as though that is how this desktop works. It is not. The
# sections at the BOTTOM override it -- sway uses the last setting it reads,
# so the tiling bindings up here are leftovers, not the truth.
#
# The parts that actually decide how this machine behaves:
#   * macOS-style desktop   -- floating, borders, Cmd-style keys
#   * Window switcher       -- swayr, Super+Tab with real history
#   * Volume overlay        -- wob
#   * Sound                 -- pipewire, pinned to HDMI output 3
#
# This file lives in ~/Projects/BishOS/dotfiles and is symlinked here, so
# editing it edits the copy in the repository.

# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term foot
# Your preferred application launcher
set $menu fuzzel

### Output configuration
#
# The wallpaper is matrix-rain (tools/matrix-rain in this repo),
# which draws on the background layer itself. This line stays as black rather
# than an image so that if it ever fails to start the desktop looks deliberate
# instead of showing a stock photo through the gap.
output * bg #000000 solid_color

# Matrix rain, drawn by the GPU on the background layer. exec_always so it
# comes back on a config reload; without it a reload leaves the old process
# running and a second one starts on top.
#
# The quotes are load-bearing. sway splits a config line on ";" into separate
# sway commands before any shell sees it, so unquoted this ran "exec_always
# pkill -x matrix-rain" and then tried "matrix-rain" as a sway command, which
# fails with "Unknown/invalid command" and no wallpaper. Quoted, the whole
# thing reaches sh as one command.
exec_always "pkill -x matrix-rain; matrix-rain --cell 12 --density 1.5 --fps 30"
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration
#
# Example configuration:
#
# exec swayidle -w \
#          timeout 300 'swaylock -f -c 000000' \
#          timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
#          before-sleep 'swaylock -f -c 000000'
#
# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

### Input configuration
#
# Example configuration:
#
#   input type:touchpad {
#       dwt enabled
#       tap enabled
#       natural_scroll enabled
#       middle_emulation enabled
#   }
#
#   input type:keyboard {
#       xkb_layout "eu"
#   }
#
# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window
    bindsym $mod+Shift+q kill

    # Start your launcher
    bindsym $mod+d exec $menu

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    # bindsym $mod+space focus mode_toggle   # rebound below to the launcher

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
#
# Utilities:
#
    # Special keys to adjust volume via PulseAudio
    bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

    # Special keys to control media via playerctl
    bindsym --locked XF86AudioPlay exec playerctl play-pause
    bindsym --locked XF86AudioPause exec playerctl play-pause
    bindsym --locked XF86AudioPrev exec playerctl previous
    bindsym --locked XF86AudioNext exec playerctl next
    bindsym --locked XF86AudioStop exec playerctl stop

    # Special keys to adjust brightness via brightnessctl
    bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
    bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+

    # Special key to take a screenshot with grim

#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
bar {
    position top

    # When the status_command prints a new line to stdout, swaybar updates.
    # The default just shows the current date and time.
    status_command while date +'%Y-%m-%d %X'; do sleep 1; done

    colors {
        statusline #ffffff
        background #323232
        inactive_workspace #32323200 #32323200 #5c5c5c
    }
}

include /etc/sway/config.d/*

# Sound. Chromium does not talk to the sound card directly -- it expects a
# sound server. PipeWire is that server; wireplumber is the part that decides
# which output to use. Both must be running before the browser starts.
exec pipewire
exec pipewire-pulse
exec wireplumber

# Force sound to HDMI output 3. The monitor reports eld_valid 0 -- it claims
# to have no audio -- so wireplumber may decide HDMI is unavailable and switch
# away from it on a later boot. It plays fine despite the claim, so pin it.
# The sleep gives wireplumber time to appear before we talk to it.
exec sh -c 'sleep 4; pactl set-card-profile alsa_card.pci-0000_00_03.0 output:hdmi-stereo; pactl set-default-sink alsa_output.pci-0000_00_03.0.hdmi-stereo; pactl set-sink-mute alsa_output.pci-0000_00_03.0.hdmi-stereo 0; pactl set-sink-volume alsa_output.pci-0000_00_03.0.hdmi-stereo 85%'

# ============================================================
#  macOS-style desktop
# ============================================================
#
# Sway tiles by default: windows share the screen automatically, and cannot be
# dragged, minimised or resized with the mouse. macOS does the opposite --
# every window floats and you place it yourself. These settings switch to the
# macOS model.
#
# Nothing above is deleted. Sway uses the LAST setting it reads, so everything
# here overrides the defaults further up the file.

# Every new window floats.
for_window [app_id=".*"] floating enable
for_window [class=".*"] floating enable

# Title bars, so a window has something to grab hold of.
# The floating border is thicker on purpose: a 2px edge is very hard to catch
# with the mouse when resizing.
default_border normal 2
default_floating_border normal 4
font pango:DejaVu Sans 11
titlebar_padding 10 5

# Open in the middle of the screen rather than the top-left corner.
for_window [app_id=".*"] move position center
for_window [class=".*"] move position center

# Hold Super and drag anywhere inside a window to move it.
# Hold Super and right-drag to resize from wherever you are pointing.
floating_modifier $mod normal

# --- macOS keys. On a Mac keyboard, Super IS the Cmd key. ---
bindsym $mod+q kill
bindsym $mod+Shift+w kill
bindsym $mod+m move scratchpad
bindsym $mod+Shift+m scratchpad show
bindsym $mod+space exec $menu
bindsym $mod+Ctrl+f fullscreen

# Maximise and restore.
#
# Toggling a floating window into tiling makes it fill the work area, and sway
# remembers where it was floating -- so toggling back puts it exactly where it
# was. That is maximise and restore, built from what sway already does.
#
# The window's own maximise button may not do this. Its minimise button
# certainly will not: sway does not implement minimise at all, so the request
# is simply ignored. Super+M and the scratchpad are the only minimise here.
bindsym $mod+Ctrl+Up floating toggle

# ============================================================
#  Window switcher (swayr)
# ============================================================
#
# swayrd records the order windows were used in. sway keeps no such history --
# its own "focus next" walks the tree by position -- so this is what makes
# Super+Tab mean "the window I was just in", the way Cmd+Tab does.
#
# --include-scratchpad matters here: minimised windows live on the scratchpad,
# and sway has no minimise of its own, so this list is the only way back to
# them without remembering what you hid.
exec swayrd

bindsym $mod+Tab exec swayr switch-window
bindsym $mod+Shift+Tab exec swayr switch-to-urgent-or-lru-window

# ============================================================
#  Volume overlay (wob)
# ============================================================
#
# wob draws a bar for any number 0-100 it is given. It has no idea what volume
# is -- the bindings below read the level after changing it and write the
# number into a named pipe that wob is reading.
#
# The pipe is recreated at startup because a stale one from a previous session
# would leave wob reading a file nothing writes to.
set $wobsock $XDG_RUNTIME_DIR/wob.sock
exec_always rm -f $wobsock && mkfifo -m 600 $wobsock && tail -f $wobsock | wob

# Volume keys, now also feeding the overlay. Muting shows 0 rather than the
# level, so the bar empties -- which is the honest picture of what you will
# hear.
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5% && pactl get-sink-volume @DEFAULT_SINK@ | head -n1 | awk '{print substr($5, 1, length($5)-1)}' > $wobsock
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5% && pactl get-sink-volume @DEFAULT_SINK@ | head -n1 | awk '{print substr($5, 1, length($5)-1)}' > $wobsock
bindsym --locked XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle && (pactl get-sink-mute @DEFAULT_SINK@ | grep -q yes && echo 0 > $wobsock || pactl get-sink-volume @DEFAULT_SINK@ | head -n1 | awk '{print substr($5, 1, length($5)-1)}' > $wobsock)

# ============================================================
#  Notifications, night light, lock, screenshots
# ============================================================

# Notifications. Without a daemon listening, programs that try to notify you
# fail silently -- nothing appears and nothing complains.
exec mako

# Night light. Warms the screen after sunset, like macOS Night Shift.
# The coordinates are Kathmandu; wlsunset works out sunrise and sunset from
# them rather than from a fixed clock time.
exec wlsunset -l 27.7 -L 85.3 -t 3500 -T 6500

# Blank the screen after 10 minutes, lock after 15, and lock before sleeping.
# swayidle only watches the clock -- swaylock does the locking, and the
# 'resume' line is what turns the screen back on afterwards.
exec swayidle -w \
    timeout 600 'swaymsg "output * power off"' \
    resume      'swaymsg "output * power on"' \
    timeout 900 'swaylock -f -c 1c1c1c' \
    before-sleep 'swaylock -f -c 1c1c1c'

# Lock now. Ctrl+Cmd+Q on macOS.
bindsym $mod+Ctrl+q exec swaylock -f -c 1c1c1c

# Screenshots. Print takes the whole screen; Shift+Print lets you drag a
# region. Both land in ~/Pictures/Screenshots with the time in the name.
#
# Not Cmd+Shift+3 and 4 as on macOS: those keys already move windows to
# workspaces 3 and 4 here.
# The notify-send call is the point: grim is silent, so without it a
# screenshot looks exactly like a key that does nothing. The file was being
# written all along.
bindsym Print exec f=~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png && grim "$f" && notify-send -t 2000 "Screenshot" "$(basename $f)"
bindsym Shift+Print exec f=~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png && grim -g "$(slurp)" "$f" && notify-send -t 2000 "Screenshot" "$(basename $f)"

# ============================================================
#  Dock
# ============================================================
#
# exec starts it detached, in the background -- no terminal window, and
# closing a terminal cannot kill it.
#
#   -d      auto-hide: appears when the pointer reaches the bottom edge
#   -hd 0   no hotspot delay. The default 20ms means the pointer has to arrive
#           quickly enough to count, which feels like the dock ignoring you
#   -nows   no workspace switcher. It defaults to eight workspaces whether or
#           not they exist, so clicking one takes you to an empty screen
#   -i 48   icon size
exec nwg-dock -d -hd 0 -nows -i 48 -p bottom
